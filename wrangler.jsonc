{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avicultura-pro",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avicultura-pro-db",
      "database_id": "0706cc77-b108-4f10-9233-02f79e53c05d"
    }
  ]
}

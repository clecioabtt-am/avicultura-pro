{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "granja-amazonas",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "granja-amazonas-db", "database_id": "COLE_AQUI_O_DATABASE_ID" }]
}
